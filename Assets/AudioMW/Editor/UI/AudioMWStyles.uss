.audiomw-chip-row {
    flex-direction: row;
    padding-left: 6px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-app_toolbar-border);
}

.audiomw-chip {
    font-size: 12px;
    padding-left: 8px;
    padding-right: 8px;
    margin-right: 2px;
    border-radius: 2px;
    color: var(--unity-colors-default-text);
}

.audiomw-chip--active {
    background-color: var(--unity-colors-highlight-background);
    color: var(--unity-colors-default-text);
}

.audiomw-list {
    border-right-width: 1px;
    border-right-color: var(--unity-colors-app_toolbar-border);
}

.audiomw-preview {
    flex-grow: 1;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
}

.audiomw-tile {
    flex-grow: 1;
    margin-right: 6px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    border-radius: 2px;
    background-color: var(--unity-colors-default-background);
    border-width: 1px;
    border-color: var(--unity-colors-app_toolbar-border);
}

.audiomw-tile__caption {
    font-size: 12px;
    color: var(--unity-colors-default-text);
}

.audiomw-tile__value {
    font-size: 15px;
    color: var(--unity-colors-default-text);
}

.audiomw-note {
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    border-radius: 2px;
    background-color: var(--unity-colors-highlight-background-inactive);
}

.audiomw-note__label {
    font-size: 12px;
    color: var(--unity-colors-default-text);
}

.audiomw-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--unity-colors-default-text);
}

.audiomw-subtitle {
    font-size: 12px;
    color: var(--unity-colors-default-text);
}

.audiomw-facts {
    font-size: 12px;
    margin-left: 8px;
    color: var(--unity-colors-default-text);
}

.audiomw-status {
    white-space: normal;
    flex-shrink: 0;
    padding-right: 6px;
    padding-left: 6px;
    padding-top: 3px;
    padding-bottom: 3px;
    font-size: 12px;
    color: var(--unity-colors-default-text);
    border-top-width: 1px;
    border-top-color: var(--unity-colors-app_toolbar-border);
}

.audiomw-group {
    -unity-font-style: bold;
    font-size: 12px;
    color: var(--unity-colors-default-text);
    opacity: 0.75;
}

.audiomw-chip-row { flex-wrap: wrap; }
.audiomw-preview .unity-button { margin-top: 4px; }
.audiomw-title { white-space: normal; }
.audiomw-group { opacity: 1; }
.audiomw-foldout-summary {
    flex-grow: 1;
    flex-shrink: 1;
    -unity-text-align: middle-right;
    color: var(--unity-colors-default-text);
    margin-right: 6px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.audiomw-primary { background-color: var(--unity-colors-highlight-background); color: var(--unity-colors-default-text); }

.audiomw-diagnostic-row { flex-direction: row; align-items: center; padding-left: 6px; padding-right: 6px; min-height: 24px; }
.audiomw-diagnostic-row .unity-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-right: 8px; }
.audiomw-diagnostic-event { flex-basis: 140px; flex-grow: 1; flex-shrink: 1; min-width: 60px; }
.audiomw-diagnostic-outcome { width: 65px; flex-shrink: 0; }
.audiomw-diagnostic-reason { flex-basis: 240px; flex-grow: 2; flex-shrink: 1; min-width: 80px; }

.audiomw-title { font-size: 18px; margin-top: 4px; margin-bottom: 6px; }
.audiomw-eyebrow { font-size: 11px; opacity: 0.75; white-space: normal; }
.audiomw-context { margin-top: 10px; padding-top: 8px; border-top-width: 1px; border-top-color: var(--unity-colors-app_toolbar-border); }
.audiomw-context .unity-label { white-space: normal; }
.audiomw-context .unity-base-field { flex-shrink: 1; }

.audiomw-chip--active, .audiomw-primary { background-color: rgba(114, 149, 61, 0.35); }
.audiomw-nav-current { border-bottom-width: 2px; border-bottom-color: rgb(164, 202, 105); opacity: 1; }

.audiomw-inspection .unity-button { white-space: normal; height: auto; min-height: 20px; }

.audiomw-runtime-card {
    margin-top: 6px;
    margin-bottom: 6px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-left-width: 2px;
    border-left-color: rgb(164, 202, 105);
    background-color: var(--unity-colors-default-background);
    white-space: normal;
    flex-shrink: 0;
}
.audiomw-runtime-card .unity-label { white-space: normal; }

.audiomw-diagnostics > .audiomw-title, .audiomw-diagnostics > .audiomw-eyebrow {
    margin-left: 8px;
    margin-right: 8px;
}
.audiomw-diagnostics-narrow .audiomw-diagnostic-row { flex-wrap: wrap; }
.audiomw-diagnostics-narrow .audiomw-diagnostic-reason {
    flex-basis: 100%;
    flex-shrink: 0;
    min-width: 0;
    margin-top: 0;
    opacity: 0.85;
    font-size: 11px;
}
.audiomw-diagnostics-narrow .audiomw-diagnostic-header .audiomw-diagnostic-reason { display: none; }
.audiomw-diagnostic-row .audiomw-diagnostic-outcome { -unity-text-align: middle-right; }

.audiomw-library-item { padding-left: 8px; padding-right: 6px; min-width: 0; width: 100%; flex-shrink: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-left; }

.audiomw-review > .audiomw-title { margin-left: 12px; margin-right: 12px; }
.audiomw-review #review-actions { padding-left: 12px; padding-right: 12px; padding-bottom: 8px; flex-shrink: 0; }
.audiomw-review .unity-foldout__text { white-space: normal; flex-shrink: 1; }
.audiomw-review .unity-foldout__toggle { height: auto; min-height: 20px; }
.audiomw-review-item { margin-top: 10px; padding-top: 6px; border-top-width: 1px; border-top-color: var(--unity-colors-app_toolbar-border); }
.audiomw-inspector-narrow .audiomw-foldout-summary { flex-basis: 100%; -unity-text-align: middle-left; margin-left: 16px; font-size: 11px; }
.audiomw-inspector-narrow > .unity-foldout > .unity-foldout__toggle { flex-wrap: wrap; height: auto; min-height: 20px; }
.audiomw-gain-compact #gain-fader { min-height: 18px; }

.audiomw-review { background-color: rgb(38, 40, 43); color: rgb(209, 214, 213); }
.audiomw-review #workspace-navigation { padding-top: 6px; padding-bottom: 6px; flex-shrink: 0; background-color: rgb(38, 40, 43); }
.audiomw-review #review-layout { flex-direction: row; flex-grow: 1; min-height: 0; }
.audiomw-review #review-library { width: 200px; flex-shrink: 0; padding: 12px 10px; background-color: rgb(29, 31, 34); border-right-width: 1px; border-right-color: rgb(63, 66, 71); }
.audiomw-review #review-center { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.audiomw-review #review-content { flex-grow: 1; padding: 16px 16px 8px 16px; }
.audiomw-review #review-context-host { width: 230px; flex-shrink: 0; padding: 12px; background-color: rgb(45, 48, 52); border-left-width: 1px; border-left-color: rgb(63, 66, 71); }
.audiomw-review #review-context .unity-label { color: rgb(161, 171, 170); }
.audiomw-review #review-context .audiomw-review-heading { color: rgb(209, 214, 213); }
.audiomw-review .audiomw-review-text { white-space: normal; margin: 4px 0; flex-shrink: 0; }
.audiomw-review #review-proposals .audiomw-proposal { white-space: normal; height: auto; min-height: 38px; -unity-text-align: middle-left; padding: 4px 8px; margin: 3px 0; }
.audiomw-review .audiomw-review-heading { font-size: 13px; -unity-font-style: bold; margin-top: 12px; }
.audiomw-review .audiomw-review-item { padding-top: 4px; padding-bottom: 12px; border-top-width: 0; border-bottom-width: 1px; border-bottom-color: rgb(63, 66, 71); }
.audiomw-review .unity-button { padding: 5px 8px; border-radius: 2px; background-color: rgb(45, 48, 52); border-width: 1px; border-color: rgb(63, 66, 71); }
.audiomw-review .unity-button:hover { background-color: rgb(54, 61, 61); }
.audiomw-review .unity-button:focus { border-color: rgb(164, 202, 105); }
.audiomw-review .audiomw-proposal-selected, .audiomw-review .audiomw-review-apply { background-color: rgb(65, 78, 48); color: rgb(164, 202, 105); }
.audiomw-review #review-actions { margin-top: 0; padding: 8px 16px 12px 16px; }
.audiomw-review #review-action-buttons { flex-direction: row; flex-wrap: wrap; }
.audiomw-review #review-action-buttons .unity-button { margin-left: 0; margin-right: 8px; }
.audiomw-review .audiomw-review-confirmation { padding: 8px 10px; border-left-width: 3px; border-left-color: rgb(222, 180, 110); background-color: rgb(29, 31, 34); }
.audiomw-review-narrow #review-library, .audiomw-review-narrow #review-context-host { display: none; }
.audiomw-review-narrow #review-context { margin-top: 16px; padding-top: 8px; border-top-width: 1px; border-top-color: rgb(63, 66, 71); }
.audiomw-review-narrow #review-proposals { margin-bottom: 12px; }

#audiomw-event-inspector { background-color: rgb(45, 48, 52); color: rgb(209, 214, 213); padding-left: 8px; padding-right: 8px; }
#audiomw-event-inspector .unity-base-field { margin-top: 5px; margin-bottom: 5px; }
#audiomw-event-inspector > .unity-foldout { border-top-width: 1px; border-top-color: rgb(63, 66, 71); padding-top: 8px; padding-bottom: 4px; }
#audiomw-event-inspector .audiomw-inspector-sound { margin-top: 8px; padding-top: 6px; }
#audiomw-event-inspector .unity-button { background-color: rgb(45, 48, 52); border-color: rgb(63, 66, 71); border-radius: 2px; min-height: 22px; }
#audiomw-event-inspector .unity-button:focus { border-color: rgb(164, 202, 105); }
#audiomw-event-inspector .unity-base-slider__dragger { background-color: rgb(164, 202, 105); border-color: rgb(164, 202, 105); }
#audiomw-event-inspector .audiomw-foldout-summary { color: rgb(161, 171, 170); }

#audiomw-event-inspector .audiomw-gain-compact { flex-direction: column; align-items: stretch; }
#audiomw-event-inspector .audiomw-gain-compact > .unity-base-field__label { margin-bottom: 4px; }
#audiomw-event-inspector .audiomw-gain-compact .unity-button { white-space: nowrap; }
.audiomw-review #workspace-navigation .unity-toolbar-button { padding: 4px 8px; border-width: 0; background-color: rgb(38, 40, 43); }
.audiomw-review #workspace-navigation #review-changes { color: rgb(164, 202, 105); background-color: rgb(65, 78, 48); }

.audiomw-surface { background-color: rgb(38, 40, 43); color: rgb(209, 214, 213); }
.audiomw-surface #workspace-navigation { padding-top: 6px; padding-bottom: 6px; flex-shrink: 0; background-color: rgb(38, 40, 43); border-bottom-color: rgb(63, 66, 71); }
.audiomw-surface #workspace-navigation .unity-toolbar-button { padding: 4px 8px; border-width: 0; background-color: rgb(38, 40, 43); }
.audiomw-surface #workspace-navigation .audiomw-nav-current { border-bottom-width: 2px; border-bottom-color: rgb(164, 202, 105); color: rgb(164, 202, 105); background-color: rgb(45, 48, 52); }
.audiomw-surface .unity-button { background-color: rgb(45, 48, 52); border-color: rgb(63, 66, 71); border-radius: 2px; min-height: 22px; }
.audiomw-surface .unity-button:hover { background-color: rgb(54, 61, 61); }
.audiomw-surface .unity-button:focus { border-color: rgb(164, 202, 105); }
.audiomw-surface .audiomw-primary, .audiomw-surface .audiomw-chip--active { color: rgb(164, 202, 105); background-color: rgb(65, 78, 48); }
.audiomw-surface .unity-collection-view__item--selected { background-color: rgb(65, 78, 48); }
.audiomw-surface .audiomw-runtime-card { background-color: rgb(29, 31, 34); border-left-color: rgb(164, 202, 105); }
.audiomw-surface .audiomw-context { border-top-color: rgb(63, 66, 71); }
.audiomw-panel-heading { font-size: 12px; -unity-font-style: bold; padding: 10px 8px; }
.audiomw-events #event-library { background-color: rgb(29, 31, 34); border-right-width: 1px; border-right-color: rgb(63, 66, 71); }
.audiomw-events #event-library .unity-toolbar { background-color: rgb(29, 31, 34); padding: 4px; height: auto; }
.audiomw-events #event-library .audiomw-chip-row { padding: 6px 4px; }
.audiomw-events #event-library .audiomw-chip { font-size: 11px; padding: 3px 5px; }
.audiomw-events #asset-overview { padding: 16px; }
.audiomw-events #source-list .unity-label { padding-left: 6px; }
.audiomw-events #source-list .unity-collection-view__item { border-bottom-width: 1px; border-bottom-color: rgb(63, 66, 71); }
.audiomw-events #source-waveform { background-color: rgb(29, 31, 34); }
.audiomw-inspector-narrow #containerMode .unity-base-field, .audiomw-inspector-narrow #selectionMode .unity-base-field { flex-direction: column; align-items: stretch; }
.audiomw-inspector-narrow #containerMode .unity-base-field__label, .audiomw-inspector-narrow #selectionMode .unity-base-field__label { margin-bottom: 4px; }
.audiomw-diagnostics > .audiomw-eyebrow { margin-top: 16px; }
.audiomw-diagnostics .audiomw-diagnostic-header { background-color: rgb(29, 31, 34); min-height: 30px; }
.audiomw-diagnostics .audiomw-diagnostic-row { border-bottom-width: 1px; border-bottom-color: rgb(63, 66, 71); }

.audiomw-music #music-layout { flex-direction: row; flex-grow: 1; min-height: 0; }
.audiomw-music #music-library { width: 190px; flex-shrink: 0; padding: 8px; background-color: rgb(29, 31, 34); border-right-width: 1px; border-right-color: rgb(63, 66, 71); }
.audiomw-music #music-content { flex-shrink: 1; min-width: 0; }
.audiomw-music #music-context-host { width: 230px; flex-shrink: 0; padding: 12px; background-color: rgb(45, 48, 52); border-left-width: 1px; border-left-color: rgb(63, 66, 71); }
.audiomw-music #music-context .unity-button { padding: 5px 8px; margin-bottom: 6px; }
.audiomw-music #music-states .unity-button { padding: 6px 10px; margin: 4px 6px 8px 0; }
.audiomw-music .audiomw-music-narrow #music-library, .audiomw-music .audiomw-music-narrow #music-context-host { display: none; }
.audiomw-music .audiomw-music-narrow #music-context { margin-top: 12px; padding-top: 8px; border-top-width: 1px; border-top-color: rgb(63, 66, 71); }

.audiomw-surface.audiomw-review .audiomw-proposal-selected, .audiomw-surface.audiomw-review .audiomw-review-apply { background-color: rgb(65, 78, 48); color: rgb(164, 202, 105); }

.audiomw-workspace #inspection-layout { flex-direction: row; flex-grow: 1; min-height: 0; }
.audiomw-workspace #inspection-library-panel { background-color: rgb(29, 31, 34); border-right-width: 1px; border-right-color: rgb(63, 66, 71); }
.audiomw-workspace #inspection-library-panel .unity-toolbar { background-color: rgb(29, 31, 34); padding: 4px; height: auto; }
.audiomw-workspace #inspection-context-host { width: 230px; flex-shrink: 0; padding: 12px; background-color: rgb(45, 48, 52); border-left-width: 1px; border-left-color: rgb(63, 66, 71); }
.audiomw-workspace #inspection-context .unity-button { white-space: normal; height: auto; min-height: 24px; margin-top: 8px; }
.audiomw-workspace #inspection-context .unity-base-field { margin-top: 8px; }
.audiomw-workspace .audiomw-workspace-narrow #inspection-context-host { display: none; }
.audiomw-workspace .audiomw-workspace-narrow #inspection-context { margin-top: 16px; padding-top: 8px; border-top-width: 1px; border-top-color: rgb(63, 66, 71); }
.audiomw-route-card { margin-top: 12px; padding: 12px; background-color: rgb(29, 31, 34); border-left-width: 2px; border-left-color: rgb(164, 202, 105); }
.audiomw-route-card .unity-button { margin-top: 8px; }

.audiomw-workspace #inspection-context .unity-object-field { flex-direction: column; align-items: stretch; }
.audiomw-workspace #inspection-context .unity-base-field__label { margin-bottom: 4px; }

.audiomw-diagnostics #diagnostics-layout { flex-direction: row; flex-grow: 1; min-height: 0; }
.audiomw-diagnostics #diagnostics-overview { flex-grow: 1; flex-shrink: 1; min-width: 0; padding: 12px; }
.audiomw-diagnostics #diagnostics-details { width: 308px; flex-shrink: 0; margin: 0; padding: 12px; border-left-width: 1px; border-left-color: rgb(63, 66, 71); background-color: rgb(45, 48, 52); }
.audiomw-diagnostics #diagnostics-details .unity-button { margin-top: 12px; min-height: 26px; white-space: normal; }
.audiomw-diagnostics .audiomw-capture-note { margin-top: 16px; color: rgb(160, 167, 168); }
.audiomw-diagnostics #diagnostics-layout.audiomw-diagnostics-stacked { flex-direction: column; }
.audiomw-diagnostics .audiomw-diagnostics-stacked #diagnostics-details { width: auto; max-height: 45%; flex-shrink: 1; border-left-width: 0; border-top-width: 1px; border-top-color: rgb(63, 66, 71); }
.audiomw-request-accepted .audiomw-diagnostic-outcome { color: rgb(164, 202, 105); }
.audiomw-request-rejected .audiomw-diagnostic-outcome { color: rgb(224, 186, 116); }

.audiomw-source-row { flex-direction: row; align-items: center; height: 24px; padding-left: 6px; padding-right: 6px; border-bottom-width: 1px; border-bottom-color: rgb(63, 66, 71); }
.audiomw-source-row #clip-name { flex-grow: 1; flex-shrink: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.audiomw-source-row #clip-format { width: 130px; flex-shrink: 0; -unity-text-align: middle-right; color: rgb(160, 167, 168); }
.audiomw-source-header { background-color: rgb(29, 31, 34); margin-top: 6px; }

.audiomw-diagnostics #diagnostic-project-library { width: 190px; flex-shrink: 0; padding: 8px; background-color: rgb(29, 31, 34); border-right-width: 1px; border-right-color: rgb(63, 66, 71); }
.audiomw-diagnostics #diagnostic-event-library { flex-grow: 1; min-height: 0; margin-top: 12px; margin-bottom: 12px; }
.audiomw-diagnostics #diagnostic-event-library .unity-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding-left: 6px; }
.audiomw-diagnostics #diagnostic-library-search { min-width: 0; width: auto; }
.audiomw-diagnostics .audiomw-diagnostics-hide-library #diagnostic-project-library { display: none; }
.audiomw-diagnostics #diagnostic-event-filter { flex-direction: row; flex-wrap: wrap; margin-top: 8px; margin-bottom: 8px; }
.audiomw-diagnostics #diagnostic-event-filter .unity-object-field { flex-grow: 1; min-width: 180px; flex-direction: column; align-items: stretch; }
.audiomw-diagnostics #diagnostic-event-filter .unity-button { align-self: flex-end; min-height: 24px; }

.audiomw-events #events-layout { flex-direction: row; flex-grow: 1; min-height: 0; }
.audiomw-events #events-context-host { width: 280px; flex-shrink: 0; padding: 12px; background-color: rgb(45, 48, 52); border-left-width: 1px; border-left-color: rgb(63, 66, 71); }
.audiomw-events #asset-context .unity-button { white-space: normal; height: auto; min-height: 24px; margin-top: 6px; }
.audiomw-events #asset-context .unity-object-field { flex-direction: column; align-items: stretch; }
.audiomw-events #asset-context .unity-base-field__label { margin-bottom: 4px; }
.audiomw-events .audiomw-events-narrow #events-context-host { display: none; }
.audiomw-events .audiomw-events-narrow #asset-context { margin-top: 16px; padding-top: 8px; border-top-width: 1px; border-top-color: rgb(63, 66, 71); }

#audiomw-event-inspector.audiomw-inspector-narrow .unity-object-field { flex-direction: column; align-items: stretch; }
#audiomw-event-inspector.audiomw-inspector-narrow .unity-object-field > .unity-base-field__label { min-width: 0; width: auto; margin-bottom: 4px; }
#audiomw-event-inspector.audiomw-inspector-narrow .unity-object-field > .unity-base-field__input { min-width: 0; width: auto; }

#audiomw-event-inspector.audiomw-inspector-narrow #clip-weight-editor .unity-base-field { flex-direction: column; align-items: stretch; }
#audiomw-event-inspector.audiomw-inspector-narrow #clip-weight-editor .unity-base-field__label { white-space: normal; width: auto; min-width: 0; margin-bottom: 4px; }

.audiomw-profile-inspector { background-color: rgb(45, 48, 52); padding: 8px; }
.audiomw-profile-inspector > .unity-label, .audiomw-profile-inspector .unity-base-field__label { white-space: normal; }
.audiomw-profile-inspector .audiomw-profile-heading { -unity-font-style: bold; font-size: 13px; margin-top: 12px; padding-top: 8px; margin-bottom: 6px; border-top-width: 1px; border-top-color: rgb(63, 66, 71); }
.audiomw-profile-inspector .unity-base-field { margin-top: 4px; margin-bottom: 4px; }
.audiomw-profile-inspector.audiomw-inspector-narrow .unity-base-field { flex-direction: column; align-items: stretch; }
.audiomw-profile-inspector.audiomw-inspector-narrow .unity-base-field > .unity-base-field__label { min-width: 0; max-width: none; width: auto; margin-bottom: 4px; }
.audiomw-profile-inspector.audiomw-inspector-narrow .unity-base-field > .unity-base-field__input { min-width: 0; width: auto; }

.audiomw-profile-inspector #music-transition-rule > .unity-foldout__toggle { height: auto; min-height: 20px; }
.audiomw-profile-inspector #music-transition-rule > .unity-foldout__toggle .unity-toggle__text { flex-shrink: 1; min-width: 0; white-space: normal; }

.audiomw-profile-inspector #mixer-parameter-binding > .unity-foldout__toggle { height: auto; min-height: 20px; }
.audiomw-profile-inspector #mixer-parameter-binding > .unity-foldout__toggle .unity-toggle__text { flex-shrink: 1; min-width: 0; white-space: normal; }

.audiomw-profile-inspector #music-layer > .unity-foldout__toggle { height: auto; min-height: 20px; }
.audiomw-profile-inspector #music-layer > .unity-foldout__toggle .unity-toggle__text { flex-shrink: 1; min-width: 0; white-space: normal; }

.audiomw-surface { font-size: 12px; }
.audiomw-surface #workspace-navigation { padding: 3px 4px; min-height: 28px; }
.audiomw-surface #workspace-navigation .unity-toolbar-button { padding: 3px 8px; min-height: 24px; margin: 0; }
.audiomw-surface .audiomw-panel-heading { padding: 8px; font-size: 12px; }
.audiomw-surface .audiomw-title { font-size: 17px; margin: 4px 0 8px 0; }
.audiomw-surface .unity-toolbar-search-field { min-height: 22px; max-height: 22px; margin: 2px; }
.audiomw-surface .unity-toolbar-search-field .unity-button { min-height: 16px; max-height: 16px; width: 16px; min-width: 16px; max-width: 16px; padding: 0; margin: 0; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.audiomw-surface .unity-object-field__input { min-height: 20px; }
.audiomw-surface .unity-object-field-display { flex-direction: row; align-items: center; min-width: 0; }
.audiomw-surface .unity-object-field-display__icon { width: 16px; height: 16px; min-width: 16px; max-width: 16px; min-height: 16px; max-height: 16px; flex-grow: 0; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.audiomw-surface .unity-object-field-display__label { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; flex-shrink: 1; }
.audiomw-surface .unity-object-field__selector { width: 18px; min-width: 18px; max-width: 18px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.audiomw-surface .unity-help-box__icon { width: 16px; min-width: 16px; height: 16px; min-height: 16px; max-height: 16px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.audiomw-profile-inspector.audiomw-inspector-narrow .unity-property-field > .unity-toggle { flex-direction: row; align-items: center; min-height: 22px; }
.audiomw-profile-inspector.audiomw-inspector-narrow .unity-property-field > .unity-toggle > .unity-base-field__label { margin-bottom: 0; flex-grow: 1; }
.audiomw-profile-inspector .unity-base-slider__dragger { background-color: rgb(164, 202, 105); }
.audiomw-surface .audiomw-preview { padding: 12px; }
.audiomw-events #asset-overview { padding: 12px; }
.audiomw-surface .audiomw-metric-row { flex-direction: row; flex-wrap: wrap; padding: 8px 0; border-bottom-width: 1px; border-bottom-color: rgb(63, 66, 71); }
.audiomw-metric-row > .unity-label { min-width: 80px; }
.audiomw-metric-row .audiomw-metric-value { flex-grow: 1; flex-shrink: 1; white-space: normal; -unity-text-align: middle-right; }
.audiomw-performance #performance-heading { font-size: 18px; -unity-font-style: bold; margin-bottom: 8px; }
.audiomw-performance .unity-label { white-space: normal; }
.audiomw-performance .audiomw-preview > .unity-label { margin: 6px 0; }
.audiomw-performance .unity-toolbar { flex-wrap: wrap; height: auto; min-height: 24px; }
.audiomw-live-edits #live-edit-list { flex-grow: 1; min-height: 0; }
.audiomw-live-edits .audiomw-live-row { flex-direction: row; align-items: center; padding: 4px 8px; border-bottom-width: 1px; border-bottom-color: rgb(63, 66, 71); }
.audiomw-live-edits .audiomw-live-row #name { flex-grow: 1; flex-shrink: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.audiomw-live-edits .audiomw-live-row .unity-button { width: 52px; flex-shrink: 0; margin-left: 4px; }
.audiomw-live-edits #live-edit-footer { flex-direction: row; flex-wrap: wrap; padding: 8px; border-top-width: 1px; border-top-color: rgb(63, 66, 71); }

.audiomw-workspace-compact #workspace-detail .unity-base-field { flex-direction: column; align-items: stretch; }
.audiomw-workspace-compact #workspace-detail .unity-base-field__label { min-width: 0; width: auto; white-space: normal; }
.audiomw-workspace #live-parameter-control > .unity-label { white-space: normal; }
.audiomw-workspace #live-parameter-control { margin-top: 12px; padding: 8px; background-color: rgb(45, 48, 52); }
.audiomw-workspace #workspace-status { white-space: normal; flex-shrink: 0; }

.audiomw-workspace-compact #workspace-detail .unity-toggle { flex-direction: row; align-items: center; }
.audiomw-workspace-compact #workspace-detail .unity-toggle > .unity-base-field__label { flex-grow: 1; }

.audiomw-profile-inspector.audiomw-inspector-narrow .unity-property-field > .unity-toggle > .unity-base-field__label { flex-basis: 0; flex-grow: 1; flex-shrink: 1; }
.audiomw-profile-inspector.audiomw-inspector-narrow .unity-property-field > .unity-toggle > .unity-base-field__input { flex-grow: 0; flex-shrink: 0; width: 16px; margin-right: 6px; }

.audiomw-profile-inspector #music-layer > .unity-foldout__toggle, .audiomw-profile-inspector #music-transition-rule > .unity-foldout__toggle { flex-direction: row; align-items: center; }
.audiomw-profile-inspector #music-layer > .unity-foldout__toggle > .unity-base-field__input, .audiomw-profile-inspector #music-transition-rule > .unity-foldout__toggle > .unity-base-field__input { flex-grow: 1; flex-shrink: 1; min-width: 0; width: 0; }

.audiomw-group-navigation { flex-wrap: wrap; height: auto; min-height: 30px; padding: 3px 6px; }
.audiomw-group-navigation .unity-toolbar-button { margin: 0 3px 0 0; padding: 0 10px; min-height: 24px; }
.audiomw-group-navigation .audiomw-section-menu { margin-left: 6px; min-width: 88px; max-width: 152px; flex-shrink: 0; }
.audiomw-group-navigation .audiomw-section-menu .unity-text-element { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.audiomw-audit-controls { padding: 8px 12px; align-items: center; }
.audiomw-audit-controls .unity-base-field { margin-right: 12px; }
.audiomw-audit .unity-list-view__item .unity-label { padding: 4px 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.audiomw-setup > .unity-scroll-view { padding: 12px; }
.audiomw-setup .unity-label { white-space: normal; }
.audiomw-setup > .unity-scroll-view { min-height: 0; flex-grow: 1; }
.audiomw-setup .audiomw-setup-form > .unity-base-field > .unity-base-field__label { width: 42%; min-width: 0; max-width: 200px; }
.audiomw-setup .audiomw-setup-form > .unity-base-field { margin: 3px 0; min-height: 22px; align-items: center; }
.audiomw-setup .unity-base-field__label { white-space: normal; flex-shrink: 0; -unity-text-align: middle-left; }
.audiomw-setup .audiomw-setup-form > .unity-button { margin: 4px 0; min-height: 24px; }
.audiomw-setup-form .unity-toggle__text { white-space: normal; flex-shrink: 1; }
.audiomw-setup .unity-help-box { flex-shrink: 0; margin: 6px 0; }
.audiomw-setup .unity-help-box__label { white-space: normal; }
.audiomw-audit .unity-list-view__item .unity-label { padding: 2px 12px; }
.audiomw-audit #audit-name { -unity-font-style: bold; }
.audiomw-audit #audit-details { font-size: 11px; }

.audiomw-studio #studio-toolbar { height: 34px; flex-shrink: 0; padding: 4px 10px; background-color: rgb(30, 32, 35); }
.audiomw-studio #studio-toolbar > .unity-label { -unity-font-style: bold; margin-right: 24px; -unity-text-align: middle-left; }
.audiomw-studio #studio-toolbar .unity-toolbar-button { padding: 0 10px; margin: 0 3px; }
.audiomw-studio #studio-browser-tabs { padding: 4px; margin: 0; flex-direction: row; flex-wrap: wrap; }
.audiomw-studio #studio-browser-tabs .unity-button { margin: 1px; padding: 3px 7px; min-height: 24px; border-radius: 2px; }
.audiomw-studio #events-context-host { width: 340px; padding: 0; background-color: rgb(39, 41, 44); }
.audiomw-studio #asset-context { padding: 8px; }
.audiomw-studio #asset-context .unity-button { margin-top: 2px; }
.audiomw-studio #asset-overview { background-color: rgb(32, 34, 37); }
.audiomw-studio #asset-title { font-size: 20px; margin: 4px 0; }
.audiomw-studio #studio-container { margin-top: 16px; min-height: 160px; padding: 12px; border-width: 1px; border-color: rgb(61, 64, 68); border-radius: 3px; background-color: rgb(26, 28, 30); }
.audiomw-studio #studio-container-heading, .audiomw-studio #studio-bin-heading { -unity-font-style: bold; font-size: 12px; margin-bottom: 8px; color: rgb(188, 195, 198); }
.audiomw-studio #studio-signal-flow { flex-direction: row; flex-wrap: wrap; margin-bottom: 12px; }
.audiomw-studio #studio-signal-flow > .unity-label { padding: 6px 8px; margin-right: 4px; background-color: rgb(45, 49, 51); border-radius: 2px; white-space: normal; }
.audiomw-studio .studio-instrument { height: 30px; margin: 2px 0; padding-left: 12px; border-left-width: 3px; border-left-color: rgb(111, 168, 133); background-color: rgb(49, 68, 59); -unity-text-align: middle-left; overflow: hidden; text-overflow: ellipsis; }
.audiomw-studio .studio-instrument:hover { background-color: rgb(61, 84, 71); }
.audiomw-studio #studio-audio-bin { margin-top: 16px; padding-top: 12px; border-top-width: 1px; border-top-color: rgb(61, 64, 68); }
.audiomw-studio #studio-audio-bin #source-list, .audiomw-studio #studio-audio-bin .audiomw-source-header { display: none; }
.audiomw-studio #studio-properties { margin-top: 12px; }
.audiomw-studio #studio-properties .unity-inspector-element { padding: 0; }
.audiomw-studio #studio-properties .unity-base-field { min-width: 0; }
.audiomw-studio .studio-instrument-selected { background-color: rgb(66, 92, 75); border-left-color: rgb(165, 202, 175); }
.audiomw-studio #studio-properties .unity-property-field { min-width: 0; flex-shrink: 1; }
.audiomw-studio #studio-properties .unity-base-field__label { min-width: 85px; max-width: 150px; flex-shrink: 1; }
.audiomw-studio #studio-properties .unity-base-field__input { min-width: 0; flex-shrink: 1; }
.audiomw-studio .studio-bank-member { min-height: 28px; -unity-text-align: middle-left; margin: 3px 0; }

.audiomw-event-editor-v2 { background-color: rgb(32,34,37); color: rgb(230,233,235); }
.audiomw-event-editor-v2 .unity-toolbar { height: 28px; flex-shrink: 0; padding: 2px 4px; background-color: rgb(40,43,46); }
.audiomw-event-editor-v2 #studio-v2-toolbar { height: 32px; }
.audiomw-event-editor-v2 #studio-v2-toolbar > .unity-label { -unity-font-style: bold; -unity-text-align: middle-left; }
.audiomw-event-editor-v2 #studio-v2-transport { height: 36px; }
.audiomw-event-editor-v2 #studio-v2-transport > .unity-label { -unity-text-align: middle-left; margin: 0 8px; }
.audiomw-event-editor-v2 #studio-v2-main { min-height: 0; }
.audiomw-event-editor-v2 #studio-v2-browser { background-color: rgb(35,38,41); }
.audiomw-event-editor-v2 #studio-v2-browser .unity-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 2px 8px; }
.audiomw-event-editor-v2 #studio-v2-browser > .unity-toolbar { flex-wrap: nowrap; }
.audiomw-event-editor-v2 #studio-v2-browser .unity-toolbar-button { padding: 0 5px; min-width: 0; flex-shrink: 1; }
.audiomw-event-editor-v2 #studio-v2-center { min-height: 0; }
.audiomw-event-editor-v2 #studio-v2-overview { width: 220px; flex-shrink: 0; padding: 12px; border-left-width: 1px; border-left-color: rgb(68,73,78); }
.audiomw-event-editor-v2 #studio-v2-overview .unity-label { white-space: normal; margin-bottom: 8px; }
.audiomw-event-editor-v2 #studio-v2-deck { background-color: rgb(40,43,46); border-top-width: 1px; border-top-color: rgb(68,73,78); padding: 6px 12px; flex-shrink: 0; }
.audiomw-event-editor-v2 #studio-v2-deck > .unity-label { height: 24px; -unity-font-style: bold; }
.audiomw-event-editor-v2 #studio-v2-dock { flex-shrink: 0; padding: 8px 12px; background-color: rgb(40,43,46); }
.audiomw-event-editor-v2 .studio-v2-active { background-color: rgb(56,73,54); color: rgb(169,207,118); }
.audiomw-event-editor-v2 #studio-v2-documents .unity-toolbar-button { max-width: 220px; overflow: hidden; text-overflow: ellipsis; }

.audiomw-event-editor-v2 .unity-toolbar-button { margin: 1px 2px; padding: 0 10px; border-width: 1px; border-color: rgb(68,73,78); border-radius: 3px; background-color: rgb(40,43,46); }
.audiomw-event-editor-v2 .unity-toolbar-button:hover { background-color: rgb(55,60,63); }
.audiomw-event-editor-v2 .studio-v2-active { background-color: rgb(56,73,54); border-color: rgb(169,207,118); color: rgb(230,233,235); }
.audiomw-event-editor-v2 #studio-v2-transport { height: auto; min-height: 38px; flex-wrap: wrap; align-items: center; padding: 4px 8px; background-color: rgb(32,34,37); }
.audiomw-event-editor-v2 #studio-v2-transport > .unity-toolbar-button,
.audiomw-event-editor-v2 #studio-v2-transport > .unity-base-field,
.audiomw-event-editor-v2 #studio-v2-transport > .unity-label { height: 26px; margin: 2px; flex-shrink: 0; }
.audiomw-event-editor-v2 #studio-emitter { width: 218px; }
.audiomw-event-editor-v2 #studio-emitter > .unity-base-field__label { min-width: 0; width: 48px; margin-right: 4px; }
.audiomw-event-editor-v2 #studio-v2-canvas-row { min-height: 120px; overflow: hidden; }
.audiomw-event-editor-v2 #studio-v2-canvas { overflow: hidden; }
.audiomw-event-editor-v2 #studio-play { background-color: rgb(56,73,54); border-color: rgb(169,207,118); }
.audiomw-event-editor-v2 #studio-view-tabs { height: 32px; background-color: rgb(32,34,37); }
.audiomw-event-editor-v2 #studio-v2-browser > .unity-toolbar-search-field { margin: 8px; height: 26px; }
.audiomw-event-editor-v2 .studio-browser-row { flex-direction: row; align-items: center; padding: 0 10px; height: 24px; }
.audiomw-event-editor-v2 .studio-browser-row > .unity-image { width: 16px; height: 16px; flex-shrink: 0; }
.audiomw-event-editor-v2 .studio-browser-row > .unity-label { flex-grow: 1; }
.audiomw-event-editor-v2 .unity-collection-view__item--selected { background-color: rgb(56,73,54); }
.audiomw-event-editor-v2 #studio-v2-documents { height: 32px; background-color: rgb(28,30,32); }
.audiomw-event-editor-v2 .studio-document-tab { flex-direction: row; border-width: 1px; border-color: rgb(68,73,78); border-radius: 3px; margin: 1px 4px 1px 0; }
.audiomw-event-editor-v2 .studio-document-tab .unity-toolbar-button { border-width: 0; background-color: rgba(0,0,0,0); margin: 0; }
.audiomw-event-editor-v2 #studio-v2-deck { padding: 6px 12px; }
.audiomw-event-editor-v2 #studio-v2-deck > .unity-label { border-bottom-width: 1px; border-bottom-color: rgb(68,73,78); margin-bottom: 8px; padding-bottom: 5px; }
.audiomw-event-editor-v2 #studio-v2-dock-tabs { background-color: rgb(32,34,37); }

.audiomw-event-editor-v2 .studio-overview-row { flex-direction: row; min-height: 32px; align-items: center; border-bottom-width: 1px; border-bottom-color: rgb(49,53,57); }
.audiomw-event-editor-v2 .studio-overview-row > .studio-overview-key { width: 62px; flex-shrink: 0; color: rgb(174,182,188); }
.audiomw-event-editor-v2 .studio-overview-row > .unity-label { margin: 0; flex-shrink: 1; }
.audiomw-event-editor-v2 .studio-overview-row > .unity-button { flex-shrink: 1; flex-grow: 1; min-width: 0; -unity-text-align: middle-left; background-color: rgba(0,0,0,0); color: rgb(169,207,118); border-width: 0; }
.audiomw-event-editor-v2 .studio-section-heading { font-size: 14px; -unity-font-style: bold; padding-bottom: 12px; }
.audiomw-event-editor-v2 .studio-asset-path { font-size: 11px; color: rgb(174,182,188); margin-top: 16px; }
.audiomw-event-editor-v2 .studio-browser-row { padding-left: 0; }

.audiomw-event-editor-v2 #studio-audition-status { flex-direction: row; flex-wrap: wrap; align-items: center; padding: 3px 10px; background-color: rgb(29,31,34); border-bottom-width: 1px; border-bottom-color: rgb(56,59,64); min-height: 26px; }
.audiomw-event-editor-v2 #studio-audition-message { flex-grow: 1; flex-shrink: 1; min-width: 120px; white-space: normal; color: rgb(184,192,202); margin-right: 8px; }
.audiomw-event-editor-v2 #studio-audio-mute { min-width: 130px; }

.audiomw-event-editor-v2 #studio-frame-rate { min-width: 73px; }
.audiomw-event-editor-v2 #studio-transport-position { min-width: 60px; -unity-text-align: middle-center; color: rgb(230,233,235); }
.audiomw-event-editor-v2 #studio-transport-position.studio-clock-visible { width: 148px; }
.audiomw-event-editor-v2 #studio-return { width: 30px; padding: 0; }
.audiomw-event-editor-v2 #studio-pause { min-width: 76px; }
.audiomw-event-editor-v2 #studio-play { min-width: 110px; }

.audiomw-event-editor-v2 #studio-browser-summary {
    padding: 6px 4px;
    border-top-width: 1px;
    border-top-color: rgb(68,73,78);
    background-color: rgb(34,36,39);
    flex-shrink: 0;
}
.audiomw-event-editor-v2 #studio-summary-name { -unity-font-style: bold; }
.audiomw-event-editor-v2 #studio-summary-detail { color: rgb(174,182,188); }
.audiomw-event-editor-v2 #studio-v2-documents .studio-document-tab.studio-v2-active { border-top-width: 2px; border-top-color: rgb(169,207,118); }
.audiomw-event-editor-v2 #studio-view-tabs .unity-toolbar-button { border-width: 0; border-radius: 0; }
.audiomw-event-editor-v2 #studio-view-tabs .studio-v2-active { border-bottom-width: 2px; border-bottom-color: rgb(169,207,118); }
.audiomw-event-editor-v2 #studio-v2-dock-tabs { height: 28px; border-top-width: 1px; border-top-color: rgb(68,73,78); }

.audiomw-event-editor-v2 #studio-v2-deck > .unity-label { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.audiomw-profile-inspector #music-layer { margin-top: 3px; margin-bottom: 3px; }
.audiomw-profile-inspector #music-layer > .unity-foldout__content { margin-left: 6px; padding: 4px 6px; border-left-width: 1px; border-left-color: rgb(63,66,71); }
.audiomw-profile-inspector #music-layer .unity-base-field { margin: 3px 0; }

.audiomw-chip-row {
    flex-direction: row;
    padding-left: 6px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-app_toolbar-border);
}

.audiomw-chip {
    font-size: 12px;
    padding-left: 8px;
    padding-right: 8px;
    margin-right: 2px;
    border-radius: 2px;
    color: var(--unity-colors-default-text);
}

.audiomw-chip--active {
    background-color: var(--unity-colors-highlight-background);
    color: var(--unity-colors-default-text);
}

.audiomw-list {
    border-right-width: 1px;
    border-right-color: var(--unity-colors-app_toolbar-border);
}

.audiomw-preview {
    flex-grow: 1;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
}

.audiomw-tile {
    flex-grow: 1;
    margin-right: 6px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    border-radius: 2px;
    background-color: var(--unity-colors-default-background);
    border-width: 1px;
    border-color: var(--unity-colors-app_toolbar-border);
}

.audiomw-tile__caption {
    font-size: 12px;
    color: var(--unity-colors-default-text);
}

.audiomw-tile__value {
    font-size: 15px;
    color: var(--unity-colors-default-text);
}

.audiomw-note {
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    border-radius: 2px;
    background-color: var(--unity-colors-highlight-background-inactive);
}

.audiomw-note__label {
    font-size: 12px;
    color: var(--unity-colors-default-text);
}

.audiomw-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--unity-colors-default-text);
}

.audiomw-subtitle {
    font-size: 12px;
    color: var(--unity-colors-default-text);
}

.audiomw-facts {
    font-size: 12px;
    margin-left: 8px;
    color: var(--unity-colors-default-text);
}

.audiomw-status {
    padding-left: 6px;
    padding-top: 3px;
    padding-bottom: 3px;
    font-size: 12px;
    color: var(--unity-colors-default-text);
    border-top-width: 1px;
    border-top-color: var(--unity-colors-app_toolbar-border);
}

.audiomw-group {
    -unity-font-style: bold;
    font-size: 12px;
    color: var(--unity-colors-default-text);
    opacity: 0.75;
}

.audiomw-chip-row { flex-wrap: wrap; }
.audiomw-preview .unity-button { margin-top: 4px; }
.audiomw-title { white-space: normal; }
.audiomw-group { opacity: 1; }
.audiomw-foldout-summary {
    flex-grow: 1;
    flex-shrink: 1;
    -unity-text-align: middle-right;
    color: var(--unity-colors-default-text);
    margin-right: 6px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.audiomw-primary { background-color: var(--unity-colors-highlight-background); color: var(--unity-colors-default-text); }

.audiomw-diagnostic-row { flex-direction: row; align-items: center; padding-left: 6px; padding-right: 6px; min-height: 24px; }
.audiomw-diagnostic-row .unity-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-right: 8px; }
.audiomw-diagnostic-event { flex-basis: 140px; flex-grow: 1; flex-shrink: 1; min-width: 60px; }
.audiomw-diagnostic-outcome { width: 65px; flex-shrink: 0; }
.audiomw-diagnostic-reason { flex-basis: 240px; flex-grow: 2; flex-shrink: 1; min-width: 80px; }

.audiomw-title { font-size: 18px; margin-top: 4px; margin-bottom: 6px; }
.audiomw-eyebrow { font-size: 11px; opacity: 0.75; white-space: normal; }
.audiomw-context { margin-top: 10px; padding-top: 8px; border-top-width: 1px; border-top-color: var(--unity-colors-app_toolbar-border); }
.audiomw-context .unity-label { white-space: normal; }
.audiomw-context .unity-base-field { flex-shrink: 1; }

.audiomw-chip--active, .audiomw-primary { background-color: rgba(43, 144, 128, 0.35); }
.audiomw-nav-current { border-bottom-width: 2px; border-bottom-color: rgb(89, 177, 162); opacity: 1; }

.audiomw-inspection .unity-button { white-space: normal; height: auto; min-height: 20px; }

.audiomw-runtime-card {
    margin-top: 6px;
    margin-bottom: 6px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-left-width: 2px;
    border-left-color: rgb(89, 177, 162);
    background-color: var(--unity-colors-default-background);
    white-space: normal;
    flex-shrink: 0;
}
.audiomw-runtime-card .unity-label { white-space: normal; }

.audiomw-diagnostics > .audiomw-title, .audiomw-diagnostics > .audiomw-eyebrow {
    margin-left: 8px;
    margin-right: 8px;
}
.audiomw-diagnostics-narrow .audiomw-diagnostic-row { flex-wrap: wrap; }
.audiomw-diagnostics-narrow .audiomw-diagnostic-reason {
    flex-basis: 100%;
    flex-shrink: 0;
    min-width: 0;
    margin-top: 0;
    opacity: 0.85;
    font-size: 11px;
}
.audiomw-diagnostics-narrow .audiomw-diagnostic-header .audiomw-diagnostic-reason { display: none; }
.audiomw-diagnostic-row .audiomw-diagnostic-outcome { -unity-text-align: middle-right; }

.audiomw-library-item { padding-left: 8px; padding-right: 6px; min-width: 0; width: 100%; flex-shrink: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-left; }
